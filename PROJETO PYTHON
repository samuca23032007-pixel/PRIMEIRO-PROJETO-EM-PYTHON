20.00,\n","        \"estoque\": 20\n","    }\n","}\n","\n","vendas = []\n","\n","\n","def mostrar_produtos():\n","    print(\"\\n--- Produtos Disponíveis ---\")\n","\n","    for codigo, produto in produtos.items():\n","        print(\n","            f\"{codigo} - {produto['nome']} | \"\n","            f\"Preço: R${produto['preco']:.2f} | \"\n","            f\"Estoque: {produto['estoque']} unidades\"\n","        )\n","\n","\n","def realizar_venda():\n","    mostrar_produtos()\n","\n","    try:\n","        escolha = int(input(\"\\nEscolha o produto: \"))\n","        quantidade = int(input(\"Quantidade desejada: \"))\n","\n","        if escolha not in produtos:\n","            print(\"\\nProduto inválido!\")\n","            return\n","\n","        produto = produtos[escolha]\n","\n","        if quantidade <= produto[\"estoque\"]:\n","\n","            valor_total = quantidade * produto[\"preco\"]\n","\n","            produto[\"estoque\"] -= quantidade\n","\n","            venda = {\n","                \"produto\": produto[\"nome\"],\n","                \"quantidade\": quantidade,\n","                \"total\": valor_total\n","            }\n","\n","            vendas.append(venda)\n","\n","            print(\"\\nVenda realizada com sucesso!\")\n","            print(f\"Produto: {produto['nome']}\")\n","            print(f\"Quantidade: {quantidade}\")\n","            print(f\"Total: R${valor_total:.2f}\")\n","\n","        else:\n","            print(\"\\nQuantidade indisponível no estoque.\")\n","\n","    except ValueError:\n","        print(\"\\nDigite apenas números.\")\n","\n","\n","def relatorio_vendas():\n","    print(\"\\n--- Relatório de Vendas ---\")\n","\n","    if len(vendas) == 0:\n","        print(\"Nenhuma venda realizada.\")\n","        return\n","\n","    total_vendido = 0\n","\n","    for venda in vendas:\n","        print(\n","            f\"\\nProduto: {venda['produto']}\"\n","            f\"\\nQuantidade: {venda['quantidade']}\"\n","            f\"\\nValor: R${venda['total']:.2f}\"\n","        )\n","\n","        total_vendido += venda[\"total\"]\n","\n","    print(f\"\\nTotal arrecadado: R${total_vendido:.2f}\")\n","\n","\n","def relatorio_gerencial():\n","    print(\"\\n--- Relatório Gerencial ---\")\n","\n","    for codigo, produto in produtos.items():\n","        print(\n","            f\"{produto['nome']} - \"\n","            f\"Estoque restante: {produto['estoque']} unidades\"\n","        )\n","\n","\n","def menu():\n","\n","    while True:\n","\n","        print(\"\\n===== SISTEMA DE VENDAS =====\")\n","        print(\"1 - Realizar Venda\")\n","        print(\"2 - Emitir Relatórios\")\n","        print(\"3 - Sair\")\n","\n","        opcao = input(\"Escolha uma opção: \")\n","\n","        if opcao == \"1\":\n","            realizar_venda()\n","\n","        elif opcao == \"2\":\n","\n","            print(\"\\n1 - Relatório de Vendas\")\n","            print(\"2 - Relatório Gerencial\")\n","\n","            escolha = input(\"Escolha uma opção: \")\n","\n","            if escolha == \"1\":\n","                relatorio_vendas()\n","\n","            elif escolha == \"2\":\n","                relatorio_gerencial()\n","\n","            else:\n","                print(\"Opção inválida.\")\n","\n","        elif opcao == \"3\":\n","            print(\"\\nPrograma encerrado!\")\n","            break\n","\n","        else:\n","            print(\"\\nOpção inválida.\")\n","\n","\n","menu()"]}],"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNbP6GT/5nGcM4HhkAmuL3Y"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}