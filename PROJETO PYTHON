# Sistema de Vendas em Python
# Projeto desenvolvido para prática de lógica de programação

produtos = {
    1: {
        "nome": "Canela",
        "preco": 2.50,
        "estoque": 100
    },
    2: {
        "nome": "Caderno",
        "preco": 15.00,
        "estoque": 50
    },
    3: {
        "nome": "Mochila",
        "preco": 120.00,
        "estoque": 20
    }
}

vendas = []


def mostrar_produtos():
    print("\n--- Produtos Disponíveis ---")

    for codigo, produto in produtos.items():
        print(
            f"{codigo} - {produto['nome']} | "
            f"Preço: R${produto['preco']:.2f} | "
            f"Estoque: {produto['estoque']} unidades"
        )


def realizar_venda():
    mostrar_produtos()

    try:
        escolha = int(input("\nEscolha o produto: "))
        quantidade = int(input("Quantidade desejada: "))

        if escolha not in produtos:
            print("\nProduto inválido!")
            return

        produto = produtos[escolha]

        if quantidade <= produto["estoque"]:
            
            valor_total = quantidade * produto["preco"]

            produto["estoque"] -= quantidade

            venda = {
                "produto": produto["nome"],
                "quantidade": quantidade,
                "total": valor_total
            }

            vendas.append(venda)

            print("\nVenda realizada com sucesso!")
            print(f"Produto: {produto['nome']}")
            print(f"Quantidade: {quantidade}")
            print(f"Total: R${valor_total:.2f}")

        else:
            print("\nQuantidade indisponível no estoque.")

    except ValueError:
        print("\nDigite apenas números.")


def relatorio_vendas():
    print("\n--- Relatório de Vendas ---")

    if len(vendas) == 0:
        print("Nenhuma venda realizada.")
        return

    total_vendido = 0

    for venda in vendas:
        print(
            f"\nProduto: {venda['produto']}"
            f"\nQuantidade: {venda['quantidade']}"
            f"\nValor: R${venda['total']:.2f}"
        )

        total_vendido += venda["total"]

    print(f"\nTotal arrecadado: R${total_vendido:.2f}")


def relatorio_gerencial():
    print("\n--- Relatório Gerencial ---")

    for codigo, produto in produtos.items():
        print(
            f"{produto['nome']} - "
            f"Estoque restante: {produto['estoque']} unidades"
        )


def menu():

    while True:

        print("\n===== SISTEMA DE VENDAS =====")
        print("1 - Realizar Venda")
        print("2 - Emitir Relatórios")
        print("3 - Sair")

        opcao = input("Escolha uma opção: ")

        if opcao == "1":
            realizar_venda()

        elif opcao == "2":

            print("\n1 - Relatório de Vendas")
            print("2 - Relatório Gerencial")

            escolha = input("Escolha uma opção: ")

            if escolha == "1":
                relatorio_vendas()

            elif escolha == "2":
                relatorio_gerencial()

            else:
                print("Opção inválida.")

        elif opcao == "3":
            print("\nPrograma encerrado!")
            break

        else:
            print("\nOpção inválida.")


menu()
